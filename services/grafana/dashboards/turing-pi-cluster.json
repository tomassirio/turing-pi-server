          },
          "editorMode": "code",
          "expr": "sum by (node) (kube_pod_container_resource_requests{job=\"kube-state-metrics\",resource=\"cpu\"} * on (namespace, pod) group_left () (kube_pod_status_phase{job=\"kube-state-metrics\",phase=\"Running\"} == 1)) / on (node) max by (node) (kube_node_status_allocatable{job=\"kube-state-metrics\",resource=\"cpu\"}) * 100",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
