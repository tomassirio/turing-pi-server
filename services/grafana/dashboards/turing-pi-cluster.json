            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "editorMode": "code",
          "expr": "sum(kube_pod_status_phase{job=\"kube-state-metrics\",phase=~\"Pending|Failed|Unknown\"}) + (sum(kube_pod_container_status_waiting_reason{job=\"kube-state-metrics\",reason!=\"ContainerCreating\"}) or on() vector(0))",
          "legendFormat": "__auto",
          "instant": true,
