      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "editorMode": "code",
          "expr": "max by (namespace, pod, reason) (kube_pod_container_status_waiting_reason{job=\"kube-state-metrics\",reason!=\"ContainerCreating\"}) > 0",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "editorMode": "code",
          "expr": "max by (namespace, pod, reason) (kube_pod_status_reason{job=\"kube-state-metrics\"}) > 0",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "editorMode": "code",
          "expr": "max by (namespace, pod, phase) (label_replace(kube_pod_status_phase{job=\"kube-state-metrics\",phase=~\"Pending|Unknown\"}, \"reason\", \"$1\", \"phase\", \"(.+)\")) > 0",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
