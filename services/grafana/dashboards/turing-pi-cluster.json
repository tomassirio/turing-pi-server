    {
      "type": "stat",
      "title": "Nodes",
      "description": "😺 Ready · 🙀 Ready but under disk/memory/PID pressure (kubelet is evicting) · ☠️ NotReady.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 10,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "editorMode": "code",
          "expr": "max by (node) (kube_node_status_condition{job=\"kube-state-metrics\",condition=\"Ready\",status=\"true\"}) - 0.5 * max by (node) (kube_node_status_condition{job=\"kube-state-metrics\",condition=~\".+Pressure\",status=\"true\"})",
          "legendFormat": "{{node}}",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0.9,
                "to": 1.1,
                "result": {
                  "text": "😺",
                  "color": "#0ca30c"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.4,
                "to": 0.6,
                "result": {
                  "text": "🙀",
                  "color": "#fab219"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": -1,
                "to": 0.1,
                "result": {
                  "text": "☠️",
                  "color": "#d03b3b"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 0.4
              },
              {
                "color": "#0ca30c",
                "value": 0.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
